exports[`renderRules > barrier × pfsense matches the snapshot 1`] = `
"# fud moat · barrier (10.3.1.254) · pfsense · checklist
# barrier doesn't get a rules script: its nat + pass rules carry the scored services.
# go through this in the webgui instead. ip blocks are on the quick block page.

[ ] firewall > rules > wan: look for pass rules with source "any" that weren't there at the start.
    disable them (don't delete, so u can show white team). leave the port forward rules alone.
[ ] firewall > nat > port forward: compare against the comp docs. don't change anything scored, ask white team.
[ ] firewall > rules > lan: the anti-lockout rule and "default allow lan to any" should be the only defaults.
[ ] system > advanced > admin access: webgui and ssh not reachable from wan. ssh key-only if u keep it on.
[ ] system > user manager: unknown users or keys? check them (leave any white team / scoring accounts alone).
[ ] diagnostics > command prompt / ssh: \`pfctl -sr | head -50\` to see what's actually loaded.
[ ] status > system logs > settings: if remote logging is set up, leave it on.
[ ] these must never be blocked: management network (172.16.1.0/24), datadog (127 ranges).
"
`;

exports[`renderRules > garage × iptables matches the snapshot 1`] = `
"#!/bin/sh
# fud moat · garage (10.3.1.5) · iptables · allowlist
# paste into a root shell. rolls back in 5 min unless u run "keep it".
set -eu
B=/etc/fud-moat
command -v iptables >/dev/null 2>&1 || { echo "✗ iptables not found"; exit 1; }
mkdir -p "$B" && chmod 700 "$B"

# a rollback from an earlier run is still pending? stop it, this run replaces it
if [ -f "$B/rollback.pid" ]; then kill "$(cat "$B/rollback.pid")" 2>/dev/null || true; rm -f "$B/rollback.pid"; fi

cat > "$B/rollback.sh" <<'FUDMOAT'
#!/bin/sh
# fud moat rollback: removes FUD_IN. ip blocks (FUD_BLOCK) stay.
B=/etc/fud-moat
while iptables -w -D INPUT -j FUD_IN 2>/dev/null; do :; done
iptables -w -F FUD_IN 2>/dev/null || true
iptables -w -X FUD_IN 2>/dev/null || true
rm -f "$B/rules.sh" "$B/rules.pending.sh" "$B/rollback.pid"
echo "✓ rolled back fud moat rules on $(hostname)"
FUDMOAT

cat > "$B/rules.pending.sh" <<'FUDMOAT'
#!/bin/sh
# fud moat rules for garage: chain FUD_IN, jumped to first from INPUT
set -eu
ipt() { iptables -w "$@"; }
ipt -N FUD_IN 2>/dev/null || true
ipt -F FUD_IN
ipt -A FUD_IN -i lo -j ACCEPT
ipt -A FUD_IN -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
ipt -A FUD_IN -m conntrack --ctstate INVALID -j DROP
ipt -A FUD_IN -s 172.16.1.0/24 -j ACCEPT -m comment --comment "trusted management network"
for n in 107.21.25.247/32 108.137.133.223/32 108.137.188.57/32 13.114.211.96/32 13.115.46.213/32 13.126.169.175/32 13.208.126.217/32 13.208.133.55/32 13.208.142.17/32 13.208.255.200/32 13.209.118.42/32 13.209.230.111/32 13.234.54.8/32 13.236.246.161/32 13.238.14.57/32 13.244.188.203/32 13.244.85.86/32 13.245.194.43/32 13.245.200.254/32 13.246.172.210/32 13.247.164.9/32 13.48.150.244/32 13.48.239.118/32 13.48.254.37/32 13.54.169.48/32 15.152.238.192/32 15.161.86.71/32 15.165.240.116/32 15.168.188.85/32 15.188.202.64/32 15.188.240.172/32 15.188.243.248/32 16.162.136.62/32 16.163.153.45/32 18.102.80.189/32 18.130.113.168/32 18.139.52.173/32 18.163.21.55/32 18.163.59.106/32 18.166.19.255/32 18.195.155.52/32 18.200.120.237/32 18.229.28.50/32 18.229.36.120/32 18.96.130.96/29 18.96.16.112/29 18.96.227.72/29 18.97.147.8/29 18.98.131.24/29 18.98.196.216/29 18.98.67.176/29 18.98.96.240/29 18.99.147.8/29 18.99.209.96/29 18.99.224.56/29 18.99.34.208/29 18.99.4.112/29 18.99.99.232/29 20.62.248.141/32 20.83.144.189/32 209.162.159.0/26 3.1.219.207/32 3.1.36.99/32 3.120.223.25/32 3.121.24.234/32 3.18.172.189/32 3.18.188.104/32 3.18.197.0/32 3.35.66.96/32 3.36.177.119/32 3.40.134.72/29 3.40.2.64/29 3.41.0.88/29 3.41.176.48/29 3.42.136.80/29 3.44.192.120/29 3.45.0.40/29 3.92.150.182/32 3.96.7.126/32 34.0.225.0/24 34.110.187.75/32 34.117.129.254/32 34.121.119.136/32 34.145.82.128/29 34.146.154.144/29 34.149.119.85/32 34.149.203.90/32 34.149.54.227/32 34.149.66.128/26 34.159.50.128/29 34.160.125.158/32 34.160.150.109/32 34.160.40.115/32 34.160.41.148/32 34.160.7.29/32 34.174.98.16/29 34.208.32.189/32 34.48.76.208/29 34.69.237.0/24 34.94.234.88/29 35.152.76.8/32 35.154.93.182/32 35.176.195.46/32 35.177.43.250/32 35.184.241.87/32 35.190.51.116/32 35.223.11.90/32 35.244.255.175/32 40.76.107.170/32 43.198.123.228/32 43.203.72.233/32 43.218.5.202/32 5.60.130.112/29 52.186.167.216/29 52.192.175.207/32 52.35.61.232/32 52.55.56.26/32 52.60.189.53/32 52.67.95.251/32 52.89.221.151/32 52.9.13.199/32 52.9.139.134/32 54.177.155.33/32 63.34.100.178/32 63.35.33.198/32 8.234.4.128/25 99.79.87.237/32; do
  ipt -A FUD_IN -s "$n" -j ACCEPT -m comment --comment "trusted datadog"
done
ipt -A FUD_IN -p tcp --dport 21 -j ACCEPT -m comment --comment "ftp (scored)"
ipt -A FUD_IN -p tcp -m multiport --dports 40000:50000 -j ACCEPT -m comment --comment "ftp passive (scored)"
ipt -A FUD_IN -s 10.3.1.0/24 -p tcp --dport 22 -j ACCEPT -m comment --comment "ssh"
ipt -A FUD_IN -p icmp --icmp-type echo-request -j ACCEPT -m comment --comment "ping"
ipt -A FUD_IN -m limit --limit 10/s -j LOG --log-prefix "fud-moat drop: "
ipt -A FUD_IN -j DROP
while ipt -D INPUT -j FUD_IN 2>/dev/null; do :; done
ipt -I INPUT 1 -j FUD_IN
# blocks go back on top of FUD_IN
if [ -f /etc/fud-moat/blocks.sh ]; then sh /etc/fud-moat/blocks.sh; fi
FUDMOAT

sh "$B/rules.pending.sh"

# lockout insurance: roll back unless "keep it" runs first
nohup sh -c "sleep 300; sh $B/rollback.sh" >/dev/null 2>&1 &
echo $! > "$B/rollback.pid"
echo "✓ rules up. rolling back in 5 min unless u run keep it from a NEW session"
"
`;

exports[`renderRules > garage × nftables matches the snapshot 1`] = `
"#!/bin/sh
# fud moat · garage (10.3.1.5) · nftables · allowlist
# paste into a root shell. rolls back in 5 min unless u run "keep it".
set -eu
B=/etc/fud-moat
command -v nft >/dev/null 2>&1 || { echo "✗ nft not found. apt install nftables (or dnf install nftables)"; exit 1; }
mkdir -p "$B" && chmod 700 "$B"

# a rollback from an earlier run is still pending? stop it, this run replaces it
if [ -f "$B/rollback.pid" ]; then kill "$(cat "$B/rollback.pid")" 2>/dev/null || true; rm -f "$B/rollback.pid"; fi

cat > "$B/rollback.sh" <<'FUDMOAT'
#!/bin/sh
# fud moat rollback: drops the fud_moat table. ip blocks (fud_moat_block) stay.
B=/etc/fud-moat
nft delete table inet fud_moat 2>/dev/null || true
rm -f "$B/rules.sh" "$B/rules.pending.sh" "$B/rollback.pid"
echo "✓ rolled back fud moat rules on $(hostname)"
FUDMOAT

# the rules, as a script so "keep it" can re-run it at boot
cat > "$B/rules.pending.sh" <<'FUDMOAT'
nft -f - <<'NFT'
add table inet fud_moat
delete table inet fud_moat
table inet fud_moat {
  set trusted_0 {
    type ipv4_addr; flags interval; auto-merge
    elements = { 172.16.1.0/24 }
  }
  set trusted_1 {
    type ipv4_addr; flags interval; auto-merge
    elements = {
      107.21.25.247/32, 108.137.133.223/32, 108.137.188.57/32, 13.114.211.96/32, 13.115.46.213/32, 13.126.169.175/32,
