cat > "$B/rollback.sh" <<'FUDMOAT'
#!/bin/sh
# fud moat rollback: removes FUD_IN. ip blocks (FUD_BLOCK) stay.
B=/etc/fud-moat
while iptables -w -D INPUT -j FUD_IN 2>/dev/null; do :; done
