/32 52.9.139.134/32 54.177.155.33/32 63.34.100.178/32 63.35.33.198/32 8.234.4.128/25 99.79.87.237/32; do
  ipt -A FUD_IN -s "$n" -j ACCEPT -m comment --comment "trusted datadog"
