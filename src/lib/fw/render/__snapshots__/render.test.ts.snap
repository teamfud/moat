FUDMOAT

cat > "$B/rules.pending.sh" <<'FUDMOAT'
#!/bin/sh
# fud moat rules for grandstand: chain FUD_IN, jumped to first from INPUT
set -eu
ipt() { iptables -w "$@"; }
ipt -N FUD_IN 2>/dev/null || true
