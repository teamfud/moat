      18.139.52.173/32, 18.163.21.55/32, 18.163.59.106/32, 18.166.19.255/32, 18.195.155.52/32, 18.200.120.237/32,
      18.229.28.50/32, 18.229.36.120/32, 18.96.130.96/29, 18.96.16.112/29, 18.96.227.72/29, 18.97.147.8/29,
      18.98.131.24/29, 18.98.196.216/29, 18.98.67.176/29, 18.98.96.240/29, 18.99.147.8/29, 18.99.209.96/29,
      18.99.224.56/29, 18.99.34.208/29, 18.99.4.112/29, 18.99.99.232/29, 20.62.248.141/32, 20.83.144.189/32,
      209.162.159.0/26, 3.1.219.207/32, 3.1.36.99/32, 3.120.223.25/32, 3.121.24.234/32, 3.18.172.189/32,
      3.18.188.104/32, 3.18.197.0/32, 3.35.66.96/32, 3.36.177.119/32, 3.40.134.72/29, 3.40.2.64/29,
      3.41.0.88/29, 3.41.176.48/29, 3.42.136.80/29, 3.44.192.120/29, 3.45.0.40/29, 3.92.150.182/32,
      3.96.7.126/32, 34.0.225.0/24, 34.110.187.75/32, 34.117.129.254/32, 34.121.119.136/32, 34.145.82.128/29,
      34.146.154.144/29, 34.149.119.85/32, 34.149.203.90/32, 34.149.54.227/32, 34.149.66.128/26, 34.159.50.128/29,
      34.160.125.158/32, 34.160.150.109/32, 34.160.40.115/32, 34.160.41.148/32, 34.160.7.29/32, 34.174.98.16/29,
      34.208.32.189/32, 34.48.76.208/29, 34.69.237.0/24, 34.94.234.88/29, 35.152.76.8/32, 35.154.93.182/32,
      35.176.195.46/32, 35.177.43.250/32, 35.184.241.87/32, 35.190.51.116/32, 35.223.11.90/32, 35.244.255.175/32,
      40.76.107.170/32, 43.198.123.228/32, 43.203.72.233/32, 43.218.5.202/32, 5.60.130.112/29, 52.186.167.216/29,
      52.192.175.207/32, 52.35.61.232/32, 52.55.56.26/32, 52.60.189.53/32, 52.67.95.251/32, 52.89.221.151/32,
      52.9.13.199/32, 52.9.139.134/32, 54.177.155.33/32, 63.34.100.178/32, 63.35.33.198/32, 8.234.4.128/25,
      99.79.87.237/32
    }
  }
  chain input {
    type filter hook input priority -10; policy drop;
    iif "lo" accept
    ct state established,related accept
    ct state invalid drop
    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert } accept
    ip saddr @trusted_0 accept comment "trusted: management network"
    ip saddr @trusted_1 accept comment "trusted: datadog"
    tcp dport { 22 } accept comment "ssh (scored)"
    icmp type echo-request accept comment "ping"
    limit rate 10/second log prefix "fud-moat drop: "
  }
}
NFT
if [ -f /etc/fud-moat/blocks.sh ]; then sh /etc/fud-moat/blocks.sh; fi
FUDMOAT

sh "$B/rules.pending.sh"

# lockout insurance: roll back unless "keep it" runs first
nohup sh -c "sleep 300; sh $B/rollback.sh" >/dev/null 2>&1 &
echo $! > "$B/rollback.pid"
echo "✓ rules up. rolling back in 5 min unless u run keep it from a NEW session"
"
`;

